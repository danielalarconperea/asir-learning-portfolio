{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ClaimConnect",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:eu-north-1:582997418897:client/sentinel-claim-*"
    },
    {
      "Sid": "ClaimPublish",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": [
        "arn:aws:iot:eu-north-1:582997418897:topic/$aws/certificates/create/json",
        "arn:aws:iot:eu-north-1:582997418897:topic/$aws/provisioning-templates/SentinelFleetProvisioning/provision/json"
      ]
    },
    {
      "Sid": "ClaimSubscribe",
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:eu-north-1:582997418897:topicfilter/$aws/certificates/create/json/accepted",
        "arn:aws:iot:eu-north-1:582997418897:topicfilter/$aws/certificates/create/json/rejected",
        "arn:aws:iot:eu-north-1:582997418897:topicfilter/$aws/provisioning-templates/SentinelFleetProvisioning/provision/json/accepted",
        "arn:aws:iot:eu-north-1:582997418897:topicfilter/$aws/provisioning-templates/SentinelFleetProvisioning/provision/json/rejected"
      ]
    },
    {
      "Sid": "ClaimReceive",
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": [
        "arn:aws:iot:eu-north-1:582997418897:topic/$aws/certificates/create/json/accepted",
        "arn:aws:iot:eu-north-1:582997418897:topic/$aws/certificates/create/json/rejected",
        "arn:aws:iot:eu-north-1:582997418897:topic/$aws/provisioning-templates/SentinelFleetProvisioning/provision/json/accepted",
        "arn:aws:iot:eu-north-1:582997418897:topic/$aws/provisioning-templates/SentinelFleetProvisioning/provision/json/rejected"
      ]
    }
  ]
}
