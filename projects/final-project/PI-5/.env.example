# Plantilla de configuracion de entorno del SOC (PI-5).
# Copiar a .env y rellenar. El .env real esta gitignored: NUNCA comitearlo.

# --- Motor de IA ---
# AI_MODE: "api" (Gemini remoto) o "local" (Ollama en local-ai-engine:11434)
AI_MODE=api
# Modelo fijado explicitamente (evitar alias movibles como gemini-flash-latest,
# que cambian de version y coste sin tocar el codigo). Decision documentada en
# docs/plan_implementacion_resiliencia_gemini_429.md.
AI_MODEL=gemini-3-flash-preview
# Para AI_MODE=local usar p. ej.: AI_MODEL=ollama/gemma4:e2b

# Clave de la API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Enriquecedor LLM offline (Fase 4) ---
# Override OPCIONAL del modelo SOLO para el batch offline (CLI/endpoint enrich).
# Si se dejan vacíos, el enriquecedor usa AI_MODE/AI_MODEL del triage (misma
# dualidad: api->Gemini online, local->Ollama offline). Permite usar un modelo
# mayor en el batch sin tocar la ruta caliente. No requiere claves nuevas.
# ENRICH_MODE=api
# ENRICH_MODEL=gemini-3-pro

# --- Dashboard HITL ---
# Sin DASHBOARD_PASSWORD (o DASHBOARD_PASSWORD_HASH) el dashboard DENIEGA
# todo acceso (fail-closed). Usar una contrasena fuerte: este panel aprueba
# comandos remotos firmados.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Alternativa: hash generado con werkzeug.security.generate_password_hash
# DASHBOARD_PASSWORD_HASH=
