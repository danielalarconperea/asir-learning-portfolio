! S1
en
conf t
interface vlan 99
ip address 172.17.99.10 255.255.255.0
no shutdown

! R1
en
conf t
interface g0/0
ip address 172.17.25.2 255.255.255.252
no shutdown
exit
interface g0/1.10
encapsulation dot1Q 10
ip address 172.17.10.1 255.255.255.0
interface g0/1.20
encapsulation dot1Q 20
ip address 172.17.20.1 255.255.255.0
interface g0/1.30
encapsulation dot1Q 30
ip address 172.17.30.1 255.255.255.0
interface g0/1.88
encapsulation dot1Q 88
ip address 172.17.88.1 255.255.255.0
interface g0/1.99
encapsulation dot1Q 99
ip address 172.17.99.1 255.255.255.0
interface g0/1
no shutdown
end

! S1
ip default-gateway 172.17.99.1
vlan 10
name Faculty/Staff
vlan 20
name Students
vlan 30
name Guest(Default)
vlan 88
name Native
vlan 99
name Management
exit

interface range fa0/11-17
switchport mode access
switchport access vlan 10
interface range fa0/18-24
switchport mode access
switchport access vlan 20
interface range fa0/6-10
switchport mode access
switchport access vlan 30
exit

interface g0/1
switchport mode trunk
switchport trunk native vlan 88 
exit

interface range fa0/1-5,g0/2
shutdown
exit

! R1
conf t
interface g0/1.88
encapsulation dot1Q 88 native
end

