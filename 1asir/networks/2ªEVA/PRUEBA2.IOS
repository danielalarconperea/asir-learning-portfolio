VLAN 10
NAME VLAN_10
VLAN 20
NAME VLAN_20
VLAN 30
NAME VLAN_30
VLAN 255
NAME VLAN_ADMINISTRATIVA

interface VLAN_255
ip address 172.16.255.1 255.255.255.0
interface VLAN_255
ip address 172.16.255.2 255.255.255.0
interface VLAN_255
ip address 172.16.255.3 255.255.255.0
interface VLAN_255
ip address 172.16.255.4 255.255.255.0

ip default-gateway 172.16.255.1

interface g1/0/10
switchport mode access
switchport access vlan 10

interface g1/0/11
switchport mode access
switchport access vlan 20

interface g1/0/12
switchport mode access
switchport access vlan 30

interface range g1/0/1-2
channel-group 1 mode active
interface port-channel 1
switchport mode trunk
switchport trunk native vlan 255
switchport trunk allowed vlan 10,20,30,255

interface range g1/0/3-4
channel-group 2 mode active
interface port-channel 2
switchport mode trunk
switchport trunk native vlan 255
switchport trunk allowed vlan 10,20,30,255

interface range g1/0/5-6
channel-group 3 mode active
interface port-channel 3
switchport mode trunk
switchport trunk native vlan 255
switchport trunk allowed vlan 10,20,30,255

spanning-tree vlan 10,20,30,255 root primary
interface range g1/0/1-24
spanning-tree portfast default

spanning-tree portfast default

ip routing
interface VLAN_10
ip address 192.168.110.1 255.255.255.0
interface VLAN_20
ip address 172.16.115.1 255.255.255.0
interface VLAN_30
ip address 192.168.100.1 255.255.255.0

ip dhcp excluded-address 192.168.110.1 192.168.110.20
ip dhcp excluded-address 172.16.110.1 192.168.110.20
ip dhcp excluded-address 192.168.100.1 192.168.110.20

ip dhcp pool VLAN_10
network 192.168.110.0 255.255.255.0 
dns-server 210.128.128.10
default-router 172.16.115.1

ip dhcp pool VLAN_20
network 172.16.115.0 255.255.255.0 
dns-server 210.128.128.10
default-router 172.16.115.1

ip dhcp pool VLAN_30
network 192.168.100.0 255.255.255.0 
dns-server 210.128.128.10
default-router 172.16.115.1

interface g1/0/24
no switchport
ip address 192.168.255.2 255.255.255.0
exit
ip route 0.0.0.0 0.0.0.0 g1/0/24

ip route 192.168.0.0 255.255.0.0 g0/0/0     
ip route 172.16.0.0 255.255.0.0 g0/0/0


enable secret cisco
line console 0
password cisco
login
exit
banner motd # Acceso restringido solo para administradores autorizados #
ex
write
conf t
username admin1 password cisco
ip domain-name ESTOYESTUDIANDOREDES.COM
crypto key generate rsa 
1024
ip ssh version 2
line vty 0 1
    login local
    transport input ssh