! 2. Configuración Básica de los Switches
enable
configure terminal
! Cambiar el nombre del dispositivo para cada switch (SW1, SW2, SW3, CORE)
hostname SW1
! Configurar la VLAN Nativa y SVI (SW1, SW2, SW3, CORE)
vlan 99
name Administrativa

! Cambia la IP según corresponda (ponemos la ip .2 porque la .1 ya esta asignada como puerta de enlace predeterminada en el CORE)
interface vlan 99
ip address 192.168.99.2 255.255.255.0  
no shutdown

! Configurar contraseñas
enable secret cisco
line console 0
password cisco
login
exit

! Configurar un mensaje de banner (CORE, SW1, SW2, SW3)
banner motd # Acceso restringido solo para administradores autorizados #

    ! Guardar la configuración
    write

! 3.Configuración Específica por Switch (CORE, SW1, SW2, SW3)
! Crear VLANs: Configura las VLANs especificadas para los switches:
vlan 10
name VLAN_10
vlan 20
name VLAN_20
vlan 30
name VLAN_30
vlan 40
name VLAN_40

! Asignar puertos a las VLANs (SW1, SW2, SW3)
! switchport mode access: Configura una interfaz como puerto de acceso, asociándola a una sola VLAN.

interface range fa0/1-5
switchport mode access
switchport access vlan 10

interface range fa0/6-10
switchport mode access
switchport access vlan 20

interface range fa0/11-15
switchport mode access
switchport access vlan 30

interface range fa0/16-20
switchport mode access
switchport access vlan 40


! Asignar puertos a las VLANs (CORE)
! switchport mode access: Configura una interfaz como puerto de acceso, asociándola a una sola VLAN.

interface range g1/0/1-5
switchport mode access
switchport access vlan 10

interface range g1/0/6-10
switchport mode access
switchport access vlan 20

interface range g1/0/11-15
switchport mode access
switchport access vlan 30

interface range g1/0/16-20
switchport mode access
switchport access vlan 40

! Apagar los puertos no utilizados
interface range fa0/21-24
shutdown
exit

! Configuración de los Enlaces Troncales
! Un trunk es un enlace que transporta tráfico de múltiples VLANs entre switches o entre un switch y un router
! 3.1. Configurar enlaces troncales en SW1 y SW2**
interface range g0/1-2
switchport mode trunk
switchport trunk native vlan 99
! Por defecto pasan todas las VLANs por el puerto pero podemos decir que solo pasen unas en específico:
switchport trunk allowed vlan 10,20,30,40,99

! 3.3. Configurar enlaces troncales en SW3
interface range fa0/23-24
switchport mode trunk
switchport trunk native vlan 99
switchport trunk allowed vlan 10,20,30,40,99

! 3.4. Configurar enlaces troncales en el CORE
! En el switch CORE, configura los enlaces hacia cada switch de acceso (SW1, SW2):

interface g1/0/1-2
switchport mode trunk
switchport trunk native vlan 99
switchport trunk allowed vlan 10,20,30,40,99

! 3.5. Creamos un GRUPO de CANALES con el protocolo LACP de CORE al SW3
! En el switch SW3, configura los enlaces hacia switch CORE:
interface range g0/1-2
channel-group 1 mode active

interface port-channel 1
switchport mode trunk
switchport trunk native vlan 99
switchport trunk allowed vlan 10,20,30,40,99

! En el switch CORE, configura los enlaces hacia switch SW3:
interface range g1/0/3-4
channel-group 1 mode active

interface port-channel 1
switchport mode trunk
switchport trunk native vlan 99
switchport trunk allowed vlan 10,20,30,40,99


!Comando para verificar interfaces troncales
show interfaces trunk
! Comando para verificar VLANs activas
show vlan brief
! Comando para verificar el estado de Spanning Tree
show spanning-tree


! Configuración de Spanning-Tree en el CORE
! En el switch CORE, configura Spanning-Tree:

spanning-tree vlan 1,10,20,30,40 root primary
interface range g1/0/1-24
spanning-tree portfast default

! El resto de switches
spanning-tree portfast default

! 5.Configuración de Enrutamiento en el CORE
! En el switch CORE, habilita el enrutamiento entre VLANs:
! Para permitir la comunicación entre diferentes VLAN dentro de una misma red

ip routing

interface vlan 10
ip address 192.168.10.1 255.255.255.0

interface vlan 20
ip address 192.168.20.1 255.255.255.0

interface vlan 30
ip address 192.168.30.1 255.255.255.0

interface vlan 40
ip address 192.168.40.1 255.255.255.0

! 6. Pruebas de Conectividad
!  1. Asigna direcciones IP estáticas a las PCs conforme al esquema.
!  2. Verifica la conectividad entre las PCs de la misma VLAN usando el comando:
!    ping <IP de la PC destino>
!  3. Verifica la conectividad entre VLANs desde el CORE (inter-VLAN routing).
!  4. Usa `traceroute` para identificar posibles problemas en el camino.

! 4.- Configura un servidor DHCP por cada VLAN Excluye las 20 primeras direcciones de cada red

! CORE
! Excluimos las primeras 20 direcciones de la LAN 10, 20, 30,40
en
conf t
ip dhcp excluded-address 192.168.10.1 192.168.10.20
ip dhcp excluded-address 192.168.20.1 192.168.20.20
ip dhcp excluded-address 192.168.30.1 192.168.30.20
ip dhcp excluded-address 192.168.40.1 192.168.40.20
ip dhcp excluded-address 192.168.99.1 192.168.99.20

! Creamos un grupo DHCP para LAN-10:
ip dhcp pool VLAN_10
network 192.168.10.0 255.255.255.0
default-router 192.168.10.1
dns-server 209.128.128.1

! Creamos un grupo DHCP para LAN-20:
ip dhcp pool VLAN_20
network 192.168.20.0 255.255.255.0
default-router 192.168.20.1
dns-server 209.128.128.1

! Creamos un grupo DHCP para LAN-30:
ip dhcp pool VLAN_30
network 192.168.30.0 255.255.255.0
default-router 192.168.30.1
dns-server 209.128.128.1

! Creamos un grupo DHCP para LAN-40:
ip dhcp pool VLAN_40
network 192.168.40.0 255.255.255.0
default-router 192.168.40.1
dns-server 209.128.128.1

! Creamos un grupo DHCP para LAN-99:
ip dhcp pool VLAN_99
network 192.168.99.0 255.255.255.0
default-router 192.168.99.1
dns-server 209.128.128.1


! R1 
! Encendemos la interfaces y las asignamos una dirección ip
interface g0/0/0
ip address 192.168.55.1 255.255.255.0
no shutdown
interface g0/0/1
ip address 209.128.128.1 255.255.255.0
no shutdown

! CORE
interface g1/0/23
no switchport
ip address 192.168.55.2 255.255.255.0

! R1 --- El camino de vuelta
ip route 192.168.0.0 255.255.0.0 g0/0/0

! CORE --- Cualquier red que no conozca
ip route 0.0.0.0 0.0.0.0 g1/0/23




































! R1
en
conf t
interface g0/0
ip helper-address 10.1.1.2
exit

! R3
en
conf t
interface g0/0
ip helper-address 10.2.2.2
exit

! R2
interface g0/1
ip address dhcp 
no shutdown
end
show ip interface brief

! Nos muestra la dirección ip y la mac de las direcciones proporcionadas
show ip dhcp binding










! Prueba la conectividad de los equipos y el enrutamiento

! 5.- Añade un router Cisco 4331, conéctalo al CORE y usa la red 192.168.1.0/24.

! Al router 4331 conéctale un servidor (internet) y usa la red 209.128.128.0/24 en este enlace.

! Configura el enrutamiento en CORE introduciendo la ruta por defecto: ip route 0.0.0.0 0.0.0.0 "interfaz de salida"

! y el router 4331 introduce la ruta resumida: ip route 192.168.0.0 255.255.0.0 "interfaz de salida"






! telnet
telnet 192.168.10.1
line console 0
password cisco
login
enable password cisco

username admin1 password cisco
ip domain-name ESTOYESTUDIANDOREDES.COM
crypto hey generate rsa
1024

ip ssh version 2
line vty 0 4
login local

! Para que solo se pueda usar ssh
transport input shh


! SSH
ssh -l admin1 192.168.10.1