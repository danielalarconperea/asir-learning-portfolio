! R2
enable
configure terminal
hostname R2
interface g0/0
ip address 192.168.255.9 255.255.255.252
no shutdown
interface g2/0
ip address 192.168.255.3 255.255.255.248
no shutdown
router ospf 2
network 192.168.255.3 255.255.255.248 area 0
network 172.7.4.1 255.255.252.0 area 0
network 192.168.255.8 0.0.0.3 area 0
! Para que sea BDR
router-id 4.4.4.4
interface g0/0
ip ospf network point-to-point

! R3
enable
configure terminal
hostname R3
interface g0/0
ip address 192.168.255.10 255.255.255.252
no shutdown
interface g3/0
ip address 192.168.255.4 255.255.255.248
no shutdown
router ospf 2
network 192.168.255.4 255.255.255.248 area 0
network 172.7.0.0 0.0.3.255 area 0
network 192.168.255.8 0.0.0.3 area 0
passive-interface g1/0
router ospf 2
router-id 3.3.3.3
interface g0/0
ip ospf network point-to-point
exit
clear-ip ospf proccess

! R1
enable
configure terminal
hostname R1
interface g0/0/0
ip address 192.168.255.1 255.255.255.248
no shutdown
exit
ip route 0.0.0.0 0.0.0.0 g0/0/1
router ospf 2
network 192.168.255.1 255.255.255.248 area 0
! Para que sea BR
router-id 5.5.5.5  
default-information originate
