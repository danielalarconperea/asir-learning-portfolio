! PC3
10.0.4.10

255.255.255.0

10.0.4.1

2001:db8:acad:4::10 /64

fe80::2:a

! PC4
10.0.5.10

255.255.255.0

10.0.5.1

2001:db8:acad:5::10 /64

fe80::2:b

! R2
en
conf t
hostname R2
enable secret c1sco1234
ip domain-name ccna-lab.com
no ip domain-lookup
service password-encryption
user SSHAdmin secret 55Hadm!n
crypto key generate rsa
1024

line console 0
password cisco
exec-timeout 6 0
login
logging synchronous
exit

line vty 0 15
password cisco
transport input ssh 
exec-timeout 6 0
login local
exit

banner motd $WARNING, ¡Acceso no autorizado!$
ipv6 unicast-routing

interface g0/0/0
description Enlace a S3

ip address 10.0.4.1 255.255.255.0
ipv6 address 2001:db8:acad:4::1/64
ipv6 address fe80::2:a link-local
no shutdown

interface g0/0/1
description Enlace a S4

ip address 10.0.5.1 255.255.255.0
ipv6 address 2001:db8:acad:5::1/64
ipv6 address fe80::2:b link-local
no shutdown

interface s0/1/0
description Enlace a R1

ip address 10.0.3.2 255.255.255.0
ipv6 address 2001:db8:acad:3::2/64
ipv6 address fe80::1:c link-local
no shutdown

interface s0/1/1
description Internet

ip address 209.165.200.225 255.255.255.252
ipv6 address 2001:db8:feed:224::1/64
ipv6 address fe80::1:d link-local
no shutdown

end

copy running-config startup-config

